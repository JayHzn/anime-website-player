# Native projects generated by `expo prebuild` / `expo run:android`.
# The app uses Expo's managed workflow (CNG): android/ and ios/ are build
# artifacts regenerated from app.json, never edited by hand — committing them
# would mean maintaining two sources of truth for the native config.
/android/
/ios/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Build output
*.apk
*.aab
*.jks
*.keystore

# Dependencies
node_modules/

# Misc
.DS_Store
*.log
